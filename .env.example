# Copy this file to .env.local and fill in the values from
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
# Everything here is free on the Firebase Spark (no-cost) plan. No card needed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check for the hosted web app: a free reCAPTCHA v3 site key
# (https://www.google.com/recaptcha/admin -> type "Score based (v3)").
VITE_RECAPTCHA_SITE_KEY=

# App Check debug token. DO NOT put it in .env.local (that file is used for the hosted build).
#   .env.development.local  -> used by `npm run dev` (localhost)
#   .env.extension.local    -> used by `npm run build:extension`
# Generate any UUID (for example with `uuidgen`) and register it in
# Firebase console -> App Check -> Apps -> Manage debug tokens.
# VITE_APPCHECK_DEBUG_TOKEN=

# Optional: show "Sign in with Google" in the library to sync across devices.
# Enable the Google provider in Firebase console -> Authentication -> Sign-in method first.
# VITE_GOOGLE_SIGNIN=true
