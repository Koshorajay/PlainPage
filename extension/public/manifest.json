{
  "manifest_version": 3,
  "name": "PlainPage",
  "short_name": "PlainPage",
  "version": "1.0.0",
  "description": "Rewrites any web page in plain, easy language. Runs on your device when it can, in the cloud when it must.",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Make this page plain",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "contextMenus"],
  "optional_host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
